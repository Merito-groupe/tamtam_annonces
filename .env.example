# Copier ce fichier en « .env » à la racine du projet, puis renseigner les valeurs.
# ⚠️ Ne JAMAIS committer le fichier .env : il est ignoré par Git.

# --- Supabase (Dashboard > Project Settings > API) -------------------------
# URL du projet
VITE_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique « publishable » (ou « anon ») — conçue pour le navigateur,
# la sécurité repose sur les politiques RLS (voir supabase/policies.sql)
VITE_SUPABASE_ANON_KEY=votre_cle_publishable

# --- Google reCAPTCHA v2 ---------------------------------------------------
# Clé de SITE (publique par nature). La clé SECRÈTE ne doit jamais être ici :
# elle sert uniquement à la vérification côté serveur.
VITE_RECAPTCHA_SITE_KEY=votre_cle_de_site
